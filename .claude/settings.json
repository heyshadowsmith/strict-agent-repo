{
  "permissions": {
    "allow": ["Bash(bash *diagnostics/*.sh)", "Bash(npm run format *)"],
    "deny": [
      "Read(README.md)",
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(tsconfig.json)",
      "Write(tsconfig.json)",
      "Edit(eslint.config.ts)",
      "Write(eslint.config.ts)",
      "Edit(.markdownlint.json)",
      "Write(.markdownlint.json)",
      "Edit(.markdownlint-cli2.jsonc)",
      "Write(.markdownlint-cli2.jsonc)",
      "Edit(.prettierrc)",
      "Write(.prettierrc)",
      "Edit(commitlint.config.ts)",
      "Write(commitlint.config.ts)",
      "Edit(.secretlintrc.json)",
      "Write(.secretlintrc.json)",
      "Edit(knip.json)",
      "Write(knip.json)",
      "Edit(vitest.config.ts)",
      "Write(vitest.config.ts)",
      "Edit(.husky/*)",
      "Write(.husky/*)",
      "Edit(.claude/*)",
      "Write(.claude/*)",
      "Edit(diagnostics/*)",
      "Write(diagnostics/*)",
      "Edit(git-checks/*)",
      "Write(git-checks/*)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(package-lock.json)",
      "Write(package-lock.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash git-checks/check-branch-state.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash git-checks/check-no-override.sh"
          },
          {
            "type": "command",
            "command": "bash git-checks/validate-branch-before-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash diagnostics/edit.sh"
          }
        ]
      }
    ]
  }
}
