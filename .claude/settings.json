{
  "permissions": {
    "allow": [
      "Bash(bash diagnostics/full.sh)",
      "Bash(bash diagnostics/commit.sh)",
      "Bash(bash diagnostics/edit.sh)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(which *)"
    ],
    "deny": [
      "Edit(README.md)",
      "Edit(CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(CLAUDE.local.md)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(.claudeignore)",
      "Edit(**/.claudeignore)",
      "Edit(tsconfig*.json)",
      "Edit(**/tsconfig*.json)",
      "Edit(eslint.config.*)",
      "Edit(**/eslint.config.*)",
      "Edit(.markdownlint*)",
      "Edit(**/.markdownlint*)",
      "Edit(.prettierrc*)",
      "Edit(**/.prettierrc*)",
      "Edit(prettier.config.*)",
      "Edit(**/prettier.config.*)",
      "Edit(.prettierignore)",
      "Edit(**/.prettierignore)",
      "Edit(.editorconfig)",
      "Edit(**/.editorconfig)",
      "Edit(commitlint.config.*)",
      "Edit(**/commitlint.config.*)",
      "Edit(.commitlintrc*)",
      "Edit(**/.commitlintrc*)",
      "Edit(.config/**)",
      "Edit(.secretlintrc*)",
      "Edit(**/.secretlintrc*)",
      "Edit(.secretlintignore)",
      "Edit(**/.secretlintignore)",
      "Edit(knip.*)",
      "Edit(**/knip.*)",
      "Edit(.knip.*)",
      "Edit(**/.knip.*)",
      "Edit(vitest.config.*)",
      "Edit(vitest.workspace.*)",
      "Edit(vite.config.*)",
      "Edit(.lintstagedrc*)",
      "Edit(**/.lintstagedrc*)",
      "Edit(lint-staged.config.*)",
      "Edit(**/lint-staged.config.*)",
      "Edit(.npmrc)",
      "Edit(**/.npmrc)",
      "Edit(.gitattributes)",
      "Edit(**/.gitattributes)",
      "Edit(.git/info/**)",
      "Edit(.github/**)",
      "Edit(.husky/**)",
      "Edit(.claude/**)",
      "Edit(**/.claude/**)",
      "Edit(diagnostics/**)",
      "Edit(git-checks/**)",
      "Edit(package.json)",
      "Edit(**/package.json)",
      "Edit(package-lock.json)",
      "Edit(**/package-lock.json)",
      "Edit(~/.claude/settings.json)",
      "Bash(git *--output*)",
      "mcp__ide__executeCode"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": ["~/.npm"]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/git-checks/check-branch-state.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/git-checks/check-no-override.sh"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/git-checks/validate-branch-before-git.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/git-checks/check-edit-branch.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/diagnostics/edit.sh"
          }
        ]
      }
    ]
  }
}
